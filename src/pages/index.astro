---
import Site from '../layouts/Site.astro';
import EarlyAccess from '../components/EarlyAccess.astro';
import Mock from '../components/Mock.astro';
---
<Site title="codemap" description="codemap resolves what your code imports, tells you what breaks if you change it, and says when it does not know. Free CLI and MCP server; paid CI check and morning ledger for teams running coding agents.">
<style>
    --bg:#1b1e26; --bg2:#20242d; --panel:#232731; --line:#343947; --line2:#2b303b;
    --text:#e6e8ee; --muted:#9aa0b0; --dim:#6b7080;
    --teal:#8fc7c2; --rust:#c96a5a; --gold:#d8b26a; --lav:#b48ac9; --green:#8fbf7f;
    --display:"Bricolage Grotesque","Instrument Sans",system-ui,sans-serif;
    --sans:"Instrument Sans","Helvetica Neue",Helvetica,sans-serif;
    --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
    --gutter:clamp(20px,5vw,72px);
  }

  /* nav */

  /* hero */
  .hero{border-top:0;padding-block:clamp(48px,7vw,104px) clamp(40px,5vw,80px)}
  .hero .copy{grid-column:1/span 6;align-self:center}
  .hero h1 em{font-style:normal;color:var(--teal)}
  .hero p.lede{margin-top:22px;font-size:1.12em;color:var(--muted);max-width:46ch}
  .install{margin-top:32px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
  .install .cmd{font-family:var(--mono);font-size:.9em;background:#0f1116;border:1px solid var(--line);padding:11px 16px;border-radius:6px;display:inline-flex;gap:10px;align-items:center}
  .install .cmd .p{color:var(--teal)}
  .install .alt{font-size:.86em;color:var(--muted)}
  .hero .shot{grid-column:7/span 6}
  .hero .cta{margin-top:28px;display:flex;gap:12px;flex-wrap:wrap}
  .hero .install{margin-top:22px;opacity:.85}
  .where .tabs{display:flex;gap:8px;margin-top:28px;flex-wrap:wrap}
  .where .tab{font-family:var(--mono);font-size:.86em;padding:8px 14px;border-radius:6px;border:1px solid var(--line);background:var(--panel);color:var(--muted);cursor:pointer}
  .where .tab.on{color:var(--teal);border-color:var(--teal)}
  .where .pane{display:none;margin-top:18px} .where .pane.on{display:block}

  /* terminal window */

  /* integrations */
  .ints h2{max-width:22ch}
  .ints ul{list-style:none;margin:40px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px}
  .int{display:grid;grid-template-columns:34px 1fr auto;grid-template-areas:"mark nm chip" "mark what chip";column-gap:14px;align-items:center;padding:14px 16px;border:1px solid var(--line2);border-radius:8px;background:var(--bg2)}
  .int .mark{grid-area:mark;width:26px;height:26px;color:var(--text)} .int .mark svg{width:26px;height:26px}
  .int .nm{grid-area:nm;font-weight:500} .int .what{grid-area:what;font-size:.8em;color:var(--muted)}
  .int .chip{grid-area:chip;font-family:var(--mono);font-size:.68em;padding:3px 8px;border-radius:999px;border:1px solid var(--line);color:var(--muted)}
  .int.live .chip{color:var(--green);border-color:rgba(143,191,127,.4)} .int.preview .chip{color:var(--gold);border-color:rgba(216,178,106,.4)}
  .int.soon .mark{opacity:.6}

  /* commands */
  .cmds .lead{grid-column:1/span 5} .cmds .lead p{margin-top:18px;color:var(--muted)}
  .cmds .stack{grid-column:6/span 7;display:grid;gap:28px;min-width:0}
  .cmds .term pre{max-height:420px}

  /* contract */
  .contract .txt{grid-column:1/span 5} .contract .txt p{margin-top:18px;color:var(--muted)}
  .contract .code{grid-column:7/span 6}
  .k{color:var(--dim)} .s{color:var(--rust)} .g{color:var(--green)}

  /* flow */
  .flow ol{list-style:none;margin:40px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .flow li{border:1px solid var(--line2);border-radius:10px;padding:22px;background:var(--bg2)}
  .flow .n{font-family:var(--mono);color:var(--teal);font-size:.8em}
  .flow h3{margin-top:8px} .flow p{margin-top:10px;font-size:.92em;color:var(--muted)}
  .flow .tier{margin-top:14px;font-family:var(--mono);font-size:.74em;color:var(--gold)}

  /* pricing */
  .pricing .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}
  .card{border:1px solid var(--line);border-radius:12px;padding:26px;background:var(--panel);display:flex;flex-direction:column}
  .card.hi{border-color:var(--teal)}
  .card .name{font-family:var(--display);font-size:1.5em;font-weight:600}
  .card .price{margin-top:6px;font-family:var(--mono);color:var(--muted);font-size:.86em}
  .card ul{margin:18px 0 0;padding:0;list-style:none;flex:1}
  .card li{padding:8px 0;border-top:1px solid var(--line2);font-size:.92em;color:var(--muted)}
  .card li b{color:var(--text);font-weight:500}
  .card .btn{margin-top:22px;text-align:center}


  @media (max-width:960px){
    .hero .copy,.hero .shot,.cmds .lead,.cmds .stack,.contract .txt,.contract .code{grid-column:1/-1}
    .flow ol,.pricing .cards{grid-template-columns:1fr}
  }

  /* flow diagram */
  .flowwrap{margin-top:36px;border:1px solid var(--line2);border-radius:14px;background:radial-gradient(ellipse at 50% 50%, #20242d 0%, var(--bg) 70%);padding:10px;overflow:hidden}
  .flow-svg{width:100%;height:auto;display:block;font-family:var(--sans)}
  .flow-svg .lbl{fill:var(--text);font-size:14px;font-weight:500}
  .flow-svg .sub{fill:var(--muted);font-size:11px}
  .flow-svg .core-lbl{fill:var(--text);font-family:var(--mono);font-size:14px;font-weight:700}
  .flow-svg .core-sub{fill:var(--muted);font-family:var(--mono)}
  .flow-svg .wire{fill:none;stroke-width:1.4;stroke-dasharray:6 8;animation:dash 1.6s linear infinite;opacity:.55;transition:opacity .25s,stroke-width .25s}
  .flow-svg .wire.in{stroke:var(--teal)}
  .flow-svg .wire.out.live{stroke:var(--teal)} .flow-svg .wire.out.preview{stroke:var(--gold)} .flow-svg .wire.out.soon{stroke:#4a4f5c;animation-duration:3.2s;opacity:.45}
  .flow-svg .wire.hot{opacity:1;stroke-width:2.4;animation-duration:.7s}
  .flow-svg .pkt{fill:var(--teal);filter:url(#soft)} .flow-svg .pkt.preview{fill:var(--gold)}
  .flow-svg .node{cursor:default;transition:transform .25s cubic-bezier(.22,1,.36,1)} .flow-svg .node:hover circle{stroke-opacity:1;stroke-width:2}
  .flow-svg .node.soon path{opacity:.55} .flow-svg .node.soon .lbl{fill:var(--muted)}
  .flow-svg .core rect{animation:pulse 3.2s ease-in-out infinite}
  @keyframes dash{to{stroke-dashoffset:-28}}
  @keyframes pulse{0%,100%{stroke-opacity:.5}50%{stroke-opacity:1}}
  .flow-legend{display:flex;gap:22px;flex-wrap:wrap;margin-top:14px;font-family:var(--mono);font-size:.74em;color:var(--muted)}
  .flow-legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:-1px}
  @media (prefers-reduced-motion:reduce){.flow-svg .wire,.flow-svg .core rect{animation:none} .flow-svg .pkt{display:none}}
  @media (max-width:700px){.flow-svg .sub{display:none} .flow-svg .lbl{font-size:18px}}

  /* features */
  .feat .cols{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:40px}
  .feat .col{border-top:2px solid var(--line);padding-top:16px}
  .feat .col.orient{border-color:var(--teal)} .feat .col.protect{border-color:var(--gold)} .feat .col.coord{border-color:var(--rust)} .feat .col.report{border-color:var(--lav)}
  .feat .verb{font-family:var(--display);font-size:1.5em;font-weight:600}
  .feat .job{font-size:.9em;color:var(--muted);margin-top:4px;min-height:2.6em}
  .feat ul{list-style:none;margin:16px 0 0;padding:0}
  .feat li{padding:9px 0;border-top:1px solid var(--line2);font-size:.9em;display:grid;grid-template-columns:1fr auto;gap:10px;align-items:start}
  .feat li b{display:block;font-weight:500;color:var(--text)} .feat li span{color:var(--muted);font-size:.92em}
  .feat .st{font-family:var(--mono);font-size:.66em;padding:2px 7px;border-radius:999px;border:1px solid var(--line);color:var(--muted);white-space:nowrap;margin-top:3px}
  .feat .st.free{color:var(--green);border-color:rgba(143,191,127,.4)} .feat .st.team{color:var(--gold);border-color:rgba(216,178,106,.4)} .feat .st.soon{color:var(--dim)}
  @media (max-width:960px){.feat .cols{grid-template-columns:1fr 1fr}} @media (max-width:600px){.feat .cols{grid-template-columns:1fr}}

  .ways .tabs{display:flex;gap:8px;margin-top:28px;flex-wrap:wrap}
  .ways .tab{font-family:var(--mono);font-size:.86em;padding:8px 14px;border-radius:6px;border:1px solid var(--line);background:var(--panel);color:var(--muted);cursor:pointer}
  .ways .tab.on{color:var(--teal);border-color:var(--teal)}
  .ways .pane{display:none;margin-top:18px;max-width:820px} .ways .pane.on{display:block}
</style>




<section class="hero grid">
  <div class="copy">
    <div class="kicker">codemap CI</div>
    <h1 style="margin-top:14px">The comment that stops two green PRs from breaking main.</h1>
    <p class="lede">Your agents open pull requests in bursts. CI tests each one against main and none against each other. codemap pair-builds the ones that share files, on your runners, and posts the pair on the PR before either merges.</p>
    <div class="cta"><a class="btn primary" href="/offer/">See the pilot offer</a><a class="btn" href="/docs/">Read the docs</a></div>
    <div class="install" id="install">
      <span class="cmd"><span class="p">$</span>brew tap JordanCoin/tap &amp;&amp; brew install codemap</span>
      <span class="alt">free CLI and MCP server, MIT</span>
    </div>
  </div>
  <div class="shot"><Mock name="ghcomment" w={860} h={760} caption="The check and the comment as a reviewer sees them. Real output shape, example repository." /></div>
</section>

<section class="where" id="where">
  <div class="kicker">Where your team sees it</div>
  <h2 style="margin-top:12px">The same facts, in the tools your team already reads.</h2>
  <div class="tabs" role="tablist">
    <button class="tab on" role="tab" data-t="github">GitHub</button>
    <button class="tab" role="tab" data-t="slack">Slack</button>
    <button class="tab" role="tab" data-t="linear">Linear</button>
    <button class="tab" role="tab" data-t="jira">Jira</button>
    <button class="tab" role="tab" data-t="confluence">Confluence</button>
    <button class="tab" role="tab" data-t="vscode">VS Code</button>
  </div>
  <div class="panes">
    <div class="pane on" data-p="github"><Mock name="github" caption="GitHub, live. Check run, sticky comment, merge order, blast facts, coverage line." /></div>
    <div class="pane" data-p="slack"><Mock name="slack" caption="Slack, building. Morning ledger per repo and one alert per confirmed collision." /></div>
    <div class="pane" data-p="linear"><Mock name="linear" caption="Linear, soon. Blast facts and collision state as an attachment on the issue." /></div>
    <div class="pane" data-p="jira"><Mock name="jira" caption="Jira, preview. Issue panel with the brief and four question shapes." /></div>
    <div class="pane" data-p="confluence"><Mock name="confluence" caption="Confluence, preview. A living brief page, re-rendered from the latest snapshot." /></div>
    <div class="pane" data-p="vscode"><Mock name="vscode" caption="VS Code, soon. Hub warning on open and the open PR already in this file." /></div>
  </div>
</section>









<section class="cmds grid" id="commands">
  <div class="lead">
    <div class="kicker">The engine underneath</div>
    <h2 style="margin-top:12px">Everything above is computed by one static binary. Free, MIT.</h2>
    <p>Where things are. Who depends on what. What breaks if you touch this. Every answer carries a coverage status, so a partial graph never reads as a complete one.</p>
    <p>Twenty-one languages through ast-grep. Go, Rust, JS/TS, Dart and Swift resolved through their real module rules, not string matching.</p>
    <p style="margin-top:26px"><a class="btn" href="https://github.com/JordanCoin/codemap#commands">All commands</a></p>
  </div>
  <div class="stack">
    <figure style="margin:0"><div class="term"><div class="bar"><i></i><i></i><i></i><span class="t">codemap .</span></div><pre>╭────────────────────────────── codemap ──────────────────────────────╮
│ Files: 282 | Size: 2.2MB                                            │
│ Top Extensions: .go (227), .yml (29), .md (22), .sh (2), .ps1 (1)   │
╰─────────────────────────────────────────────────────────────────────╯
<span style="font-weight:600">codemap</span>
├── <span style="color:#7aa2d6;font-weight:600">  .claude/skills/</span> <span style="opacity:.55">(2 files, 9.7KB)</span>
│   └── <span style="opacity:.55">... 2 directories</span>
├── <span style="color:#7aa2d6;font-weight:600">  .github/</span> <span style="opacity:.55">(9 files, 16.2KB)</span>
│   └── <span style="opacity:.55">... 3 directories, 4 files</span>
├── <span style="color:#7aa2d6;font-weight:600">  .playwright-mcp/</span> <span style="opacity:.55">(10.7KB)</span>
│   └── <span style="opacity:.55">... 1 file</span>
├── <span style="color:#7aa2d6;font-weight:600">  analysis/</span> <span style="opacity:.55">(2 files, 3.6KB, all .go)</span>
│   └── <span style="opacity:.55">... 2 files</span>
├── <span style="color:#7aa2d6;font-weight:600">  cmd/</span> <span style="opacity:.55">(47 files, 463.2KB, all .go)</span>
│   └── <span style="opacity:.55">... 1 directory, 46 files</span>
├── <span style="color:#7aa2d6;font-weight:600">  config/</span> <span style="opacity:.55">(2 files, 23.2KB, all .go)</span>
│   └── <span style="opacity:.55">... 2 files</span>
├── <span style="color:#7aa2d6;font-weight:600">  docs/</span> <span style="opacity:.55">(2 files, 22.2KB, all .md)</span>
│   └── <span style="opacity:.55">... 2 files</span>
├── <span style="color:#7aa2d6;font-weight:600">  find/</span> <span style="opacity:.55">(2 files, 8.3KB, all .go)</span>
│   └── <span style="opacity:.55">... 2 files</span>
├── <span style="color:#7aa2d6;font-weight:600">  handoff/</span> <span style="opacity:.55">(10 files, 65.9KB, all .go)</span>
