---
interface Props { name: string; w?: number; h?: number; caption?: string }
const { name, w = 1240, h = 800, caption } = Astro.props;
const files = import.meta.glob('../mocks/*', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const html = files[`../mocks/${name}.html`];
const css = files[`../mocks/${name}.css`];
if (!html || !css) throw new Error(`mock ${name} missing`);
---
<figure class="mockfig">
  <div class="mock" style={`aspect-ratio:${w}/${h}`} data-w={w}>
    <div class="mock-root" data-name={name} style={`width:${w}px;height:${h}px`} set:html={html}></div>
  </div>
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>
<Fragment set:html={`<style>${css}</style>`} />
<style is:global>
  .mockfig{margin:0;min-width:0;max-width:100%}
  .mock{width:100%;position:relative;overflow:hidden;border-radius:10px;border:1px solid var(--line);box-shadow:0 20px 60px rgba(0,0,0,.35);background:#fff}
  .mock-root{position:absolute;left:0;top:0;transform-origin:top left;font-family:"Instrument Sans","Helvetica Neue",Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#1f2328;-webkit-font-smoothing:antialiased}
  .mock-root *{box-sizing:border-box}
  .mock-root h1,.mock-root h2,.mock-root h3{font-family:inherit;font-weight:500;letter-spacing:0;line-height:1.25;font-size:inherit;margin:0}
  .mock-root p{max-width:none;margin:0}
  .mock-root a{color:#0969da;text-decoration:none}
  .mock-root pre,.mock-root code,.mock-root .mono{font-family:"JetBrains Mono",ui-monospace,Menlo,monospace}
</style>
<script is:inline>
(function(){
  if (window.__mockFit) return; window.__mockFit = true;
  function fit(m){ var r=m.querySelector('.mock-root'); if(!r) return; r.style.transform='scale('+(m.clientWidth/(+m.dataset.w))+')'; }
  function all(){ document.querySelectorAll('.mock').forEach(fit); }
  if (document.readyState==='loading') document.addEventListener('DOMContentLoaded', all); else all();
  if (window.ResizeObserver) { var ro=new ResizeObserver(function(es){ es.forEach(function(e){ fit(e.target); }); }); document.addEventListener('DOMContentLoaded', function(){ document.querySelectorAll('.mock').forEach(function(m){ ro.observe(m); }); }); if (document.readyState!=='loading') document.querySelectorAll('.mock').forEach(function(m){ ro.observe(m); }); }
})();
</script>
