---
interface Props { title: string; description: string; wide?: boolean }
const { title, description, wide = false } = Astro.props;
const posthog = import.meta.env.PUBLIC_POSTHOG_KEY;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content="/skyline-animated.gif">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style is:global>
  :root {
    --bg:#1b1e26; --bg2:#20242d; --panel:#232731; --line:#343947; --line2:#2b303b;
    --text:#e6e8ee; --muted:#9aa0b0; --dim:#6b7080;
    --teal:#8fc7c2; --rust:#c96a5a; --gold:#d8b26a; --lav:#b48ac9; --green:#8fbf7f;
    --display:"Bricolage Grotesque","Instrument Sans",system-ui,sans-serif;
    --sans:"Instrument Sans","Helvetica Neue",Helvetica,sans-serif;
    --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
    --gutter:clamp(20px,5vw,72px);
  }
  *{box-sizing:border-box}
  html{color-scheme:dark}
  body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);font-size:clamp(16px,1vw+12px,18px);line-height:1.55;-webkit-font-smoothing:antialiased;padding-inline:var(--gutter)}
  a{color:inherit} a:hover{color:var(--teal)}
  h1,h2,h3{margin:0;font-family:var(--display);font-weight:500;letter-spacing:-0.02em;line-height:1.05}
  h1{font-size:clamp(40px,5.6vw,80px);font-weight:600}
  h2{font-size:clamp(28px,3.4vw,46px)}
  h3{font-size:1.15em}
  p{margin:0;max-width:60ch} p+p{margin-top:1em}
  .muted{color:var(--muted)}
  code,pre{font-family:var(--mono)}
  .kicker{font-family:var(--mono);font-size:.8em;color:var(--teal);letter-spacing:.04em}
  section{padding-block:clamp(56px,7vw,110px);border-top:1px solid var(--line2);overflow:hidden}
  .grid{display:grid;grid-template-columns:repeat(12,1fr);column-gap:24px;row-gap:32px}
  .grid > *{min-width:0}
  .nav{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-block:18px;border-bottom:1px solid var(--line2);flex-wrap:wrap}
  .wordmark{font-family:var(--mono);font-weight:700;font-size:20px;text-decoration:none;display:flex;align-items:center;gap:10px}
  .wordmark svg{width:22px;height:22px}
  .nav ul{display:flex;gap:clamp(14px,2.6vw,34px);list-style:none;margin:0;padding:0;font-size:.92em;flex-wrap:wrap}
  .nav ul a{text-decoration:none;color:var(--muted)} .nav ul a:hover{color:var(--text)}
  .btn{display:inline-block;padding:10px 16px;border-radius:6px;text-decoration:none;font-weight:500;font-size:.92em;border:1px solid var(--line);color:var(--text);background:var(--panel);cursor:pointer;font-family:inherit}
  .btn:hover{border-color:var(--teal);color:var(--teal)}
  .btn.primary{background:var(--teal);color:#101317;border-color:var(--teal)} .btn.primary:hover{background:#a9dcd8;color:#101317}
  .btn.mono{font-family:var(--mono);font-size:.86em}
  .term{background:#0f1116;border:1px solid var(--line);border-radius:10px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.35);min-width:0;max-width:100%}
  .term .bar{display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--line2);background:#161920}
  .term .bar i{width:11px;height:11px;border-radius:50%;background:#3a3f4c;display:inline-block}
  .term .bar i:nth-child(1){background:#e0645a} .term .bar i:nth-child(2){background:#e2b445} .term .bar i:nth-child(3){background:#5fc46a}
  .term .bar .t{margin-left:auto;font-family:var(--mono);font-size:.74em;color:var(--dim)}
  .term pre{margin:0;padding:16px 18px;font-size:.78em;line-height:1.5;overflow-x:auto;white-space:pre;color:var(--text);max-width:100%;display:block}
  .term img{display:block;width:100%;height:auto}
  .cap{font-family:var(--mono);font-size:.76em;color:var(--dim);margin-top:10px}
  figure{margin:0;min-width:0;max-width:100%}
  footer{padding-block:32px 44px;border-top:1px solid var(--line2);display:flex;flex-wrap:wrap;gap:14px 34px;font-size:.84em;color:var(--dim)}
  footer a{text-decoration:none;color:var(--muted)}
  /* prose pages */
  .prose{max-width:72ch;padding-block:clamp(40px,6vw,80px)}
  .prose h1{font-size:clamp(32px,4.4vw,56px)}
  .prose h2{font-size:clamp(22px,2.4vw,30px);margin-top:44px;padding-top:18px;border-top:1px solid var(--line2)}
  .prose h3{margin-top:26px}
  .prose p{margin-top:12px;max-width:68ch;color:var(--text)}
  .prose ul,.prose ol{margin:12px 0 0;padding-left:20px;color:var(--text)} .prose li{margin:6px 0}
  .prose .banner{border-left:3px solid var(--gold);background:rgba(216,178,106,.12);padding:12px 16px;margin-top:22px;font-size:.95em}
  .prose .ph{font-family:var(--mono);background:rgba(216,178,106,.18);color:var(--gold);padding:1px 6px;border-radius:4px}
  .prose table{border-collapse:collapse;width:100%;margin-top:16px;font-size:.92em}
  .prose th,.prose td{text-align:left;padding:8px 10px;border-top:1px solid var(--line2);vertical-align:top}
  /* early access form */
  .ea{margin-top:28px;border:1px solid var(--line);border-radius:12px;padding:22px;background:var(--panel);max-width:640px}
  .ea h3{font-family:var(--display);font-size:1.3em}
  .ea .row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
  .ea label{display:flex;flex-direction:column;gap:6px;font-size:.86em;color:var(--muted)}
  .ea input,.ea select{background:#0f1116;border:1px solid var(--line);border-radius:6px;padding:10px 12px;color:var(--text);font:inherit;font-size:.95em}
  .ea input:focus,.ea select:focus{outline:2px solid var(--teal);outline-offset:1px}
  .ea .full{grid-column:1/-1}
  .ea .out{margin-top:12px;font-family:var(--mono);font-size:.86em;color:var(--teal);min-height:1.4em}
  @media (max-width:600px){.ea .row{grid-template-columns:1fr}}
</style>
{posthog && <script is:inline set:html={`!function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);posthog.init(${JSON.stringify(posthog)},{api_host:"https://us.i.posthog.com",person_profiles:"identified_only"});`} />}
</head>
<body>
<header class="nav">
  <a class="wordmark" href="/"><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="5" y="14" width="6" height="13" fill="#c96a5a"/><rect x="13" y="5" width="6" height="22" fill="#8fc7c2"/><rect x="21" y="17" width="6" height="10" fill="#d8b26a"/></svg>codemap</a>
  <ul>
    <li><a href="/#features">Features</a></li>
    <li><a href="/#integrations">Integrations</a></li>
    <li><a href="/offer/">Offer</a></li>
    <li><a href="/pricing/">Pricing</a></li>
    <li><a href="/docs/">Docs</a></li>
    <li><a href="/security/">Security</a></li>
    <li><a href="https://github.com/JordanCoin/codemap">GitHub</a></li>
  </ul>
  <a class="btn mono" href="/#install">brew install codemap</a>
</header>
<slot />
<footer>
  <span>codemap · MIT</span>
  <a href="https://github.com/JordanCoin/codemap">github.com/JordanCoin/codemap</a>
  <a href="/docs/">Docs</a>
  <a href="/security/">Security</a>
  <a href="/terms/">Terms</a>
  <a href="/privacy/">Privacy</a>
  <span>Powered by ast-grep</span>
  <span>Logos belong to their owners</span>
</footer>
</body>
</html>
